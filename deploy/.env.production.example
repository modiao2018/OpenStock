# ============================================================
# HappyStock 生产环境配置模板
# 首次部署时 deploy/first-deploy.sh 会把它复制为仓库根目录的
# .env.production 并自动生成两个随机密钥，其余项需要手动填写。
# 该文件包含密钥，已被 .gitignore 忽略，不会进 git / 镜像。
# ============================================================

# ---------- 部署参数 ----------
# 网站在宿主机上的端口（容器内固定 3000），nginx 反代到这里
WEB_PORT=3000
# 端口绑定地址：默认 127.0.0.1（只给本机 nginx 用，不暴露公网）；
# 不用 nginx 想直接访问 IP:3000 时改成 0.0.0.0
WEB_BIND=127.0.0.1
# MongoDB root 密码（first-deploy.sh 自动生成，之后不要改；
# 改了会连不上已初始化的数据库）
MONGO_ROOT_PASSWORD=
# 是否同时部署催化剂监控守护进程（true/false）
MONITOR_ENABLED=false

# ---------- 必填 ----------
# better-auth 会话签名密钥（first-deploy.sh 自动生成）
BETTER_AUTH_SECRET=
# 网站对外访问地址，必须是用户浏览器里实际访问的地址！
# 走 nginx 反代（80 端口）就不带端口号，例：http://152.53.176.254
# 以后上了域名/HTTPS 改成 https://你的域名
BETTER_AUTH_URL=
# 账号审核员邮箱（逗号分隔）。新注册账号需由这些邮箱登录后在"账号审核"页通过才可登录；
# 审核员自己注册时自动通过。留空则没人能审核，新用户全部卡在待审核！
ADMIN_EMAILS=
# Finnhub 行情 API key（https://finnhub.io 免费注册）
# 注意：这个 key 会在构建时打进前端代码，改动后要重新执行 deploy/update.sh
NEXT_PUBLIC_FINNHUB_API_KEY=

# 数据库连接串：容器内由 compose 自动注入（指向 mongodb 容器），
# 此处无需填写，留着只是为了在宿主机上跑脚本时可用
# MONGODB_URI=

# ---------- AI（新闻摘要 / 试验标题翻译等）----------
# 可选 gemini / minimax / siray，留空则相关功能降级
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=
SIRAY_API_KEY=

# ---------- 邮件（注册欢迎邮件、告警兜底）----------
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# ---------- Inngest 后台任务（可选，不用则留空）----------
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ---------- Kit 邮件营销（可选）----------
KIT_API_KEY=
KIT_API_SECRET=
KIT_WELCOME_FORM_ID=

# ---------- Adanos（可选）----------
# 免费版 250 次/月，每个来源算一次请求；快照存 Mongo，按 symbol 每 ADANOS_CACHE_HOURS 小时最多刷新一次
ADANOS_API_BASE_URL=
ADANOS_API_KEY=
# 只拉这些来源（逗号分隔：reddit,x,news,polymarket），留空 = 全部四个
ADANOS_SOURCES=
# 快照有效期（小时），默认 24
ADANOS_CACHE_HOURS=
# 月额度剩余不足该值时停止刷新、只读快照，默认 10
ADANOS_QUOTA_RESERVE=

# ---------- catalyst-monitor 催化剂监控（MONITOR_ENABLED=true 时使用）----------
# Bark 推送地址（iPhone 装 Bark App，复制"服务器"页完整地址含设备 key）
# 除了催化剂监控，新用户注册待审核时也会往这里推一条（web 容器同样读它）
BARK_URL=
# SEC EDGAR 要求 User-Agent 带联系方式，填你的邮箱
EDGAR_CONTACT=
# healthchecks.io 掉线告警 ping 地址（可选）
HEALTHCHECK_URL=
# Bark 失败时的邮件兜底收件人（需配置上面的 NODEMAILER）
ALERT_EMAIL=
# Alpaca 行情 key（盘面异动检测 + AI 低吸页日线数据，免费注册 alpaca.markets）
ALPACA_API_KEY=
ALPACA_API_SECRET=
# 内部人卖出提醒阈值（美元，默认 10000000）：单笔超过即报，7 日内 3 人以上合计超过也报；买入每笔必报
INSIDER_SELL_MIN_USD=
# Twelve Data key（可选，https://twelvedata.com 免费注册）：行情第二源，收盘后抽样与 Alpaca 交叉验证
TWELVEDATA_API_KEY=
