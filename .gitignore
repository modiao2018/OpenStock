# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 部署配置模板不含密钥，需要进 git
!deploy/.env.production.example

# deploy 发版记录（服务器本地状态）、本机部署目标配置、增量传输基底
/deploy/releases.log
/deploy/local.env
/deploy/images.tar

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
